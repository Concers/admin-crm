// =============================================================================
// Kadim Naturel — Mini ERP / Cari & Stok Takip Sistemi
// Canonical Prisma schema (single source of truth for the database)
//
// This schema is owned exclusively by the backend service. The frontend must
// not keep its own Prisma schema; it consumes data through the backend API.
// All model and field names are in English; Turkish business terms are noted
// in comments for traceability against the original Excel workbook.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Business-partner classification (TANIMLAMA → MÜŞTERİ/TEDARİKÇİ/HİZMET VEREN).
enum PartnerType {
  CUSTOMER // Müşteri
  SUPPLIER // Tedarikçi
  SERVICE_PROVIDER // Hizmet Veren
  OWNER // El Patron (şirket sahibi / ortak)
  OTHER
}

/// Whether an expense is a company-wide overhead or tied to a specific product.
enum ExpenseScope {
  GENERAL // Genel_Giderler
  PRODUCT // ÜRÜN_GİDERLERİ
}

/// Direction of a cash movement on a partner's current account (cari hesap).
enum CashFlowType {
  PAYMENT // Tedarikçi Ödeme (para çıkışı)
  COLLECTION // Müşteri Tahsilat (para girişi)
}

/// Role-based access control levels (spec D).
enum UserRole {
  ADMIN // Yönetici — tüm finansal veriler
  SALES_REP // Satış Temsilcisi — sadece satış girişi
  WAREHOUSE_MANAGER // Depo Sorumlusu — alım & stok
}

/// Kasa/Banka hesap türü.
enum AccountType {
  CASH // Kasa
  BANK // Banka
}

/// Stok hareket türü.
enum StockMovementType {
  IN // Giriş (alım, üretim)
  OUT // Çıkış (satış)
  ADJUSTMENT // Sayım düzeltmesi
  TRANSFER // Depolar arası transfer
  WASTE // Fire/zayiat
}

// -----------------------------------------------------------------------------
// Master data
// -----------------------------------------------------------------------------

/// Cari hesap — a customer, supplier, service provider or owner.
model Partner {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  type        PartnerType
  contactInfo String? // free-text contact line
  phone       String?
  email       String?
  address     String?
  priceTier   String? // fiyat segmenti (WHOLESALE/RETAIL…) — fiyat listesi eşleşmesi

  // --- Cari detay alanları (§5) ---------------------------------------------
  taxNumber      String? // Vergi No / VKN
  mersisNo       String? // Mersis No
  website        String? // web sitesi
  tcNo           String? // TC (birey: müşteri / hizmet veren)
  companyName    String? // firma ismi (bireysel carinin firması)
  companyAddress String? // firma adresi
  shopName       String? // dükkan bilgileri (müşteri)
  shopAddress    String? // dükkan adresi (müşteri)
  sector         String? // sektör (hizmet veren)
  serviceAreas   String? // hizmet alanları (hizmet veren)
  instagram      String?
  youtube        String?
  linkedin       String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchasesAsSupplier Purchase[]
  salesAsCustomer     Sale[]
  expensesAsProvider  Expense[]
  cashFlows           CashFlow[]
  contacts            Contact[]
  paymentInstruments  PaymentInstrument[]
  productLinks        ProductPartnerLink[]
  materialLinks       MaterialPartnerLink[]
  requestForms        RequestForm[]

  @@index([type])
}

/// Cari'ye bağlı birden çok iletişim kişisi.
model Contact {
  id        Int      @id @default(autoincrement())
  partnerId Int
  name      String
  title     String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

/// Ürün — a sellable / purchasable product.
model Product {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  category      String? // Gıda, Kozmetik vb.
  shelfLocation String? // raf bilgisi
  barcode       String? // barkod
  unit          String   @default("adet") // ölçü birimi (adet, kg, lt…)
  minStock      Float? // minimum stok / yeniden sipariş seviyesi
  isActive      Boolean  @default(true)

  // --- Ürün Detay (ürün kartı) — regülasyon & botanik künyesi -----------------
  productCode      String? // ürün kodu (barkoddan ayrı iç kod)
  sectors          String? // ürün sektörü, çoklu (CSV: GIDA,KOZMETIK,TICARI,TEG)
  gtipCode         String? // GTİP kodu
  hsCode           String? // HS kodu
  unCode           String? // UN kodu
  botanicalName    String? // botanik adı
  englishName      String? // İngilizce adı
  casNo            String? // CAS No
  inciNo           String? // INCI No
  origin           String? // menşei
  chemotype        String? // kemotip
  genotype         String? // genotip
  variety          String? // varyete
  geoPopulation    String? // coğrafi popülasyon
  plantPart        String? // bitkinin hangi bölümü
  productionMethod String? // üretim şekli
  der              String? // DER
  history          String? // tarihçe
  usageAreas       String? // kullanım alanları (sektörel; CSV/serbest)
  description      String? // açıklamalar
  isBfm            Boolean @default(false) // BFM ÜRÜN (çok bileşenli satış ürünü)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases      Purchase[]
  sales          Sale[]
  expenses       Expense[]
  developments   ProductDevelopment[]
  stockMovements StockMovement[]
  costHistory    ProductCostHistory[]
  links          ProductLink[]
  partnerLinks   ProductPartnerLink[]

  @@index([category])
  @@index([barcode])
}

/// Ürün karti içerik bağlantısı — bilimsel makale / blog / instagram.
enum ProductLinkKind {
  ARTICLE // bilimsel makale
  BLOG // blog yazısı
  INSTAGRAM // instagram içeriği
}

model ProductLink {
  id        Int             @id @default(autoincrement())
  productId Int
  kind      ProductLinkKind
  title     String // başlık / ayırt edici not
  url       String? // link
  note      String? // kişisel not
  createdAt DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Ürün ↔ cari ilişkisi: mevcut/potansiyel tedarikçi veya düzenli müşteri.
enum ProductPartnerRole {
  SUPPLIER // satın aldığımız tedarikçi
  POTENTIAL_SUPPLIER // satın almadığımız ama alabileceğimiz potansiyel tedarikçi
  CUSTOMER // bu ürünü düzenli alan müşteri (B2B/B2C)
}

model ProductPartnerLink {
  id        Int                @id @default(autoincrement())
  productId Int
  partnerId Int
  role      ProductPartnerRole
  note      String?
  createdAt DateTime           @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([productId, partnerId, role])
  @@index([productId])
  @@index([partnerId])
}

// -----------------------------------------------------------------------------
// Materyal Detay — ambalaj / etiket / sticker / diğer materyaller.
// Hem kendi markamız (OWN) hem B2B satılacak ürünlerin künyesi.
// -----------------------------------------------------------------------------

/// Materyal kartı — ör. "Doypack 500ml Kraft", "Şişe 100ml Amber".
model Material {
  id         Int      @id @default(autoincrement())
  name       String // kart adı
  category   String // AMBALAJ / ETIKET / STICKER / DIGER
  subType    String? // Doypack, Şişe, Tüp, Kartuş, Şase, Kutu, Poşet… (serbest)
  scope      String   @default("OWN") // OWN (kendi markamız) / B2B / BOTH
  model      String?
  color      String? // renk
  size       String? // ölçü
  material   String? // malzemesi
  unitPrice  Float? // birim fiyat
  currency   String   @default("TRY")
  usageAreas String? // kullanım alanları
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  partnerLinks MaterialPartnerLink[]
  priceBreaks  MaterialPriceBreak[]

  @@index([category])
  @@index([subType])
}

enum MaterialPartnerRole {
  SUPPLIER // tedarikçi
  CUSTOMER // müşteri (B2B)
}

model MaterialPartnerLink {
  id         Int                 @id @default(autoincrement())
  materialId Int
  partnerId  Int
  role       MaterialPartnerRole
  note       String?
  createdAt  DateTime            @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  partner  Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([materialId, partnerId, role])
  @@index([materialId])
  @@index([partnerId])
}

/// Kademeli fiyat — "X adet fiyatı" (minQty adet alımda birim/paket fiyatı).
model MaterialPriceBreak {
  id         Int      @id @default(autoincrement())
  materialId Int
  minQty     Float // X adet
  price      Float // o adetteki fiyat
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

/// Lookup of expense category names defined in TANIMLAMA, scoped to general
/// overheads (Kira, Elektrik…) or product expenses (Dolum, Ambalaj…).
model ExpenseCategory {
  id        Int          @id @default(autoincrement())
  name      String
  scope     ExpenseScope
  createdAt DateTime     @default(now())

  @@unique([name, scope])
  @@index([scope])
}

// -----------------------------------------------------------------------------
// Transactions
// -----------------------------------------------------------------------------

/// Ürün Alım — a purchase (goods in from a supplier).
model Purchase {
  id                Int      @id @default(autoincrement())
  date              DateTime
  productId         Int
  supplierId        Int
  unitPrice         Float // birim alım fiyatı
  quantity          Float // alım adeti
  vatRate           Float    @default(0.2) // KDV oranı
  totalAmount       Float // toplam tutar (KDV hariç)
  vatIncludedAmount Float // KDV dahil tutar
  paidAmount        Float    @default(0) // peşin ödenen tutar
  shelfLocation     String? // konulan raf
  dueDate           DateTime? // vade tarihi
  currency          String   @default("TRY")
  exchangeRate      Float    @default(1)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id])
  supplier Partner @relation(fields: [supplierId], references: [id])

  @@index([date])
  @@index([productId])
  @@index([supplierId])
}

/// Ürün Satış — a sale (goods out to a customer).
/// NOTE: in the source Excel the customer was stored under a column labelled
/// "TEDARİKÇİ"; per the migration spec this actually represents the customer.
model Sale {
  id                Int      @id @default(autoincrement())
  date              DateTime
  productId         Int
  customerId        Int
  unitPrice         Float // birim satış fiyatı
  quantity          Float // satış adeti
  vatRate           Float    @default(0.2)
  totalAmount       Float
  vatIncludedAmount Float
  paidAmount        Float    @default(0)
  shelfLocation     String? // hangi raf
  dueDate           DateTime? // vade tarihi
  currency          String   @default("TRY")
  exchangeRate      Float    @default(1)
  notes             String?

  // --- Calculated cost & profitability fields (maliyet & kârlılık motoru) ---
  purchaseUnitCost   Float? // alım birim maliyeti
  productionUnitCost Float? // üretim birim maliyeti
  overheadUnitCost   Float? // genel giderler maliyet payı
  totalUnitCost      Float? // toplam birim maliyeti
  profitMargin       Float? // kâr oranı (%)

  // Period helpers carried over from the workbook for fast reporting.
  periodMonth Int? // ay
  periodYear  Int? // yıl

  salesRepId Int? // satışı giren/atanan satış temsilcisi (User.id) — performans raporu

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id])
  customer Partner @relation(fields: [customerId], references: [id])

  @@index([date])
  @@index([productId])
  @@index([customerId])
  @@index([salesRepId])
}

/// Gider Girişi — an expense, optionally amortised across several months
/// (amortisman/tahakkuk mantığı: durationMonths > 1 spreads the cost evenly).
model Expense {
  id          Int          @id @default(autoincrement())
  date        DateTime
  scope       ExpenseScope // ürün gideri / genel
  category    String // gider türü (Kira, Şirket Kuruluş, Dolum…)
  productId   Int? // set when scope = PRODUCT
  partnerId   Int? // hizmet veren / tedarikçi
  totalAmount Float // toplam tutar
  paidAmount  Float        @default(0) // peşin ödenen tutar
  notes       String?
  /// Fatura / belge numarası (Excel NOTLAR içinde "Fatura No: …" olarak gelir).
  invoiceNo   String?

  // --- Amortisation window ---
  durationMonths Int? // gider periyodu (ay)
  monthlyShare   Float? // aylık gider payı (= paid / durationMonths)
  startMonth     Int?
  startYear      Int?
  endMonth       Int?
  endYear        Int?
  startDate      DateTime?
  endDate        DateTime?

  /// 1-based row number in the "Gider Girişi" sheet (null = manually added).
  excelRow       Int?     @unique
  /// Raw month label from Excel column C (OCAK, MART, …).
  excelMonthLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([date])
  @@index([scope])
  @@index([productId])
}

/// Kasa/Banka hareketi — payments to suppliers and collections from customers.
model CashFlow {
  id        Int          @id @default(autoincrement())
  date      DateTime
  partnerId Int
  accountId Int? // hangi kasa/banka hesabından
  type      CashFlowType
  amount    Float
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  partner     Partner             @relation(fields: [partnerId], references: [id])
  account     Account?            @relation(fields: [accountId], references: [id])
  allocations PaymentAllocation[]

  @@index([date])
  @@index([partnerId])
  @@index([accountId])
}

/// Kasa/Banka hesabı.
model Account {
  id             Int         @id @default(autoincrement())
  name           String      @unique
  type           AccountType
  currency       String      @default("TRY")
  openingBalance Float       @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cashFlows CashFlow[]
  paymentInstruments PaymentInstrument[]
}

/// Depo / lokasyon.
model Warehouse {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  location  String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  movements StockMovement[]
}

/// Fiziksel raf lokasyonları — ürün shelfLocation ile eşleşir; boş raflar takip edilir.
model Shelf {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  location  String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Stok hareket defteri — alım/satış dışındaki açık hareketler
/// (sayım düzeltmesi, fire, depolar arası transfer).
model StockMovement {
  id          Int               @id @default(autoincrement())
  date        DateTime          @default(now())
  productId   Int
  warehouseId Int?
  type        StockMovementType
  quantity    Float // pozitif = giriş, negatif = çıkış etkisi türle yorumlanır
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([date])
  @@index([productId])
}

/// Yeni Ürün Takip — R&D / new-product onboarding pipeline.
model ProductDevelopment {
  id              Int       @id @default(autoincrement())
  productName     String // ürün adı (free text; may predate a Product row)
  productId       Int? // linked once the product is formally defined
  startDate       DateTime? // işlem başlangıç tarihi
  supplierName    String? // tedarikçi
  orderQuantity   Float? // sipariş adedi
  productClass    String? // sınıf
  isRawMaterial   Boolean? // hammadde mi
  orderPlaced     Boolean? // sipariş verildi
  priceReceived   Boolean? // fiyat alındı
  sampleReceived  Boolean? // numune alındı
  sampleApproved  Boolean? // numune onaylandı
  productionBegun Boolean? // üretim başladı
  productionDone  Boolean? // üretim bitti
  notes           String?
  /// Full Excel row map (50 attribute rows per product column).
  attributes      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product? @relation(fields: [productId], references: [id])
}

// -----------------------------------------------------------------------------
// Auth & audit (spec D) — reserved for the access-control phase.
// -----------------------------------------------------------------------------

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String // CREATE / UPDATE / DELETE
  entityName String // Sale, Purchase, Expense…
  entityId   Int?
  details    String? // JSON snapshot / diff
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityName])
}

// =============================================================================
// Phase 4 — ERP document modules (orders, quotes, invoices, returns, BOM/
// production, price lists, discounts, attachments).
//
// These use plain Int foreign keys (no @relation back-refs) to avoid cluttering
// the core Partner/Product models; routes resolve related names as needed.
// =============================================================================

enum DocumentType {
  SALES // satış
  PURCHASE // alım
}

enum OrderStatus {
  DRAFT // taslak
  CONFIRMED // onaylandı
  DELIVERED // teslim edildi
  CANCELLED // iptal
}

enum InvoiceStatus {
  DRAFT
  ISSUED // kesildi
  PAID // ödendi
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT // gönderildi
  ACCEPTED // kabul
  REJECTED // red
}

enum ProductionStatus {
  PLANNED // planlandı
  IN_PROGRESS // üretimde
  DONE // tamamlandı
  CANCELLED
}

enum ReturnType {
  SALES_RETURN // satış iadesi
  PURCHASE_RETURN // alım iadesi
}

/// Sipariş (satış/alım siparişi) başlığı.
model Order {
  id                Int         @id @default(autoincrement())
  docType           DocumentType
  partnerId         Int
  date              DateTime    @default(now())
  status            OrderStatus @default(DRAFT)
  totalAmount       Float       @default(0)
  vatIncludedAmount Float       @default(0)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lines OrderLine[]

  @@index([partnerId])
  @@index([status])
}

model OrderLine {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Float
  unitPrice Float
  vatRate   Float @default(0.2)
  lineTotal Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Teklif başlığı.
model Quote {
  id                Int         @id @default(autoincrement())
  partnerId         Int
  date              DateTime    @default(now())
  validUntil        DateTime?
  status            QuoteStatus @default(DRAFT)
  totalAmount       Float       @default(0)
  vatIncludedAmount Float       @default(0)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lines QuoteLine[]

  @@index([partnerId])
}

model QuoteLine {
  id        Int   @id @default(autoincrement())
  quoteId   Int
  productId Int
  quantity  Float
  unitPrice Float
  vatRate   Float @default(0.2)
  lineTotal Float

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

/// Fatura başlığı (satış/alım).
model Invoice {
  id                Int           @id @default(autoincrement())
  docType           DocumentType
  partnerId         Int
  orderId           Int?
  number            String?
  date              DateTime      @default(now())
  dueDate           DateTime?
  status            InvoiceStatus @default(DRAFT)
  totalAmount       Float         @default(0)
  vatIncludedAmount Float         @default(0)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@index([partnerId])
  @@index([status])
}

/// Kısmi ödeme / fatura mutabakatı — bir tahsilat/ödeme (CashFlow) tutarının
/// bir faturaya tahsis edilen kısmını tutar. Bir fatura birden çok ödemeyle,
/// bir ödeme birden çok faturaya bölünebilir.
model PaymentAllocation {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  cashFlowId Int
  amount     Float
  createdAt  DateTime @default(now())

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cashFlow CashFlow @relation(fields: [cashFlowId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([cashFlowId])
}

model InvoiceLine {
  id        Int   @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Float
  unitPrice Float
  vatRate   Float @default(0.2)
  lineTotal Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// İrsaliye (sevk belgesi).
model DeliveryNote {
  id        Int          @id @default(autoincrement())
  docType   DocumentType
  partnerId Int
  orderId   Int?
  date      DateTime     @default(now())
  notes     String?
  createdAt DateTime     @default(now())

  lines DeliveryNoteLine[]

  @@index([partnerId])
}

model DeliveryNoteLine {
  id             Int   @id @default(autoincrement())
  deliveryNoteId Int
  productId      Int
  quantity       Float

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
}

/// İade (satış/alım).
model Return {
  id        Int        @id @default(autoincrement())
  type      ReturnType
  partnerId Int
  productId Int
  date      DateTime   @default(now())
  quantity  Float
  amount    Float      @default(0)
  reason    String?
  notes     String?
  createdAt DateTime   @default(now())

  @@index([partnerId])
  @@index([productId])
}

/// Ürün reçetesi (mamul → bileşen hammaddeler).
model Bom {
  id         Int      @id @default(autoincrement())
  productId  Int // üretilen mamul
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  components BomComponent[]
  productionOrders ProductionOrder[]

  @@index([productId])
}

model BomComponent {
  id                 Int   @id @default(autoincrement())
  bomId              Int
  componentProductId Int // bileşen hammadde
  quantity           Float // mamul başına miktar

  bom Bom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
}

/// Üretim emri.
model ProductionOrder {
  id        Int              @id @default(autoincrement())
  bomId     Int?
  productId Int
  quantity  Float
  status    ProductionStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  bom          Bom?          @relation(fields: [bomId], references: [id])
  requestForms RequestForm[]

  @@index([status])
}

// -----------------------------------------------------------------------------
// Talep Formu — Üretim Emri'nden üreticiye (PRODUCTION) veya Tedarik Emri'nden
// tedarikçiye (PROCUREMENT) gönderilen talep belgesi.
// -----------------------------------------------------------------------------

enum RequestFormType {
  PRODUCTION // üretim talebi (kime ürettireceğiz)
  PROCUREMENT // tedarik talebi (hammadde/malzeme alımı)
}

enum RequestFormStatus {
  DRAFT // taslak
  SENT // gönderildi
  FULFILLED // karşılandı
  CANCELLED // iptal
}

model RequestForm {
  id                Int               @id @default(autoincrement())
  type              RequestFormType
  partnerId         Int // kime: üretici (PRODUCTION) veya tedarikçi (PROCUREMENT)
  productionOrderId Int? // PRODUCTION formu bir üretim emrinden üretildiyse
  date              DateTime          @default(now())
  status            RequestFormStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  partner         Partner           @relation(fields: [partnerId], references: [id])
  productionOrder ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  lines           RequestFormLine[]

  @@index([type])
  @@index([partnerId])
  @@index([status])
}

model RequestFormLine {
  id        Int     @id @default(autoincrement())
  formId    Int
  productId Int?  // tanımlı ürün (opsiyonel)
  itemName  String // serbest metin ad (ürün seçilmezse)
  quantity  Float
  unit      String? // birim
  note      String?

  form RequestForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

/// Fiyat listesi.
model PriceList {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  currency  String   @default("TRY")
  tier      String? // bu liste hangi müşteri segmentine ait (Partner.priceTier ile eşleşir)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items PriceListItem[]

  @@index([tier])
}

model PriceListItem {
  id          Int   @id @default(autoincrement())
  priceListId Int
  productId   Int
  price       Float

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId])
}

/// İskonto / kampanya.
model Discount {
  id        Int       @id @default(autoincrement())
  name      String
  percent   Float? // yüzde iskonto
  amount    Float? // tutar iskontosu
  productId Int?
  partnerId Int?
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

/// Dosya eki (polimorfik: herhangi bir kayda iliştirilir).
model Attachment {
  id         Int      @id @default(autoincrement())
  entityName String // Invoice, Order, Partner, Product…
  entityId   Int
  category   String? // ürün kartında: ANALIZ / SERTIFIKA / GORSEL / ETIKET
  fileName   String
  url        String
  mimeType   String?
  size       Int?
  uploadedAt DateTime @default(now())

  @@index([entityName, entityId])
}

/// Dönem kapatma — muhasebesi/mutabakatı biten dönemlere geriye dönük kayıt
/// girişini/değişikliğini kilitler. `month` null ise tüm yıl kilitlenir.
model PeriodLock {
  id        Int      @id @default(autoincrement())
  year      Int
  month     Int? // 1-12; null = tüm yıl
  note      String?
  createdAt DateTime @default(now())

  @@unique([year, month])
  @@index([year])
}

// -----------------------------------------------------------------------------
// Finans — bütçe, çek/senet, maliyet geçmişi
// -----------------------------------------------------------------------------

enum BudgetMetric {
  SALES_REVENUE // aylık satış hedefi (KDV hariç)
  EXPENSE_TOTAL // aylık toplam gider hedefi
  EXPENSE_CATEGORY // gider türü bazlı hedef
}

/// Aylık bütçe hedefi — gerçekleşen ile karşılaştırılır.
model BudgetTarget {
  id        Int          @id @default(autoincrement())
  year      Int
  month     Int // 1-12
  metric    BudgetMetric
  category  String? // EXPENSE_CATEGORY için gider türü adı
  amount    Float
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([year, month, metric, category])
  @@index([year, month])
}

enum InstrumentType {
  CHEQUE // çek
  PROMISSORY_NOTE // senet
}

enum InstrumentDirection {
  RECEIVABLE // alınan çek/senet (müşteri)
  PAYABLE // verilen çek/senet (tedarikçi)
}

enum InstrumentStatus {
  PORTFOLIO // portföyde
  DEPOSITED // bankaya verildi / ciro
  COLLECTED // tahsil edildi
  PAID // ödendi
  BOUNCED // karşılıksız
  CANCELLED
}

/// Çek ve senet portföyü.
model PaymentInstrument {
  id        Int                 @id @default(autoincrement())
  type      InstrumentType
  direction InstrumentDirection
  partnerId Int
  accountId Int?
  number    String?
  amount    Float
  currency  String              @default("TRY")
  issueDate DateTime
  dueDate   DateTime
  status    InstrumentStatus    @default(PORTFOLIO)
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  partner Partner  @relation(fields: [partnerId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([dueDate])
  @@index([status])
  @@index([partnerId])
}

/// Ürün birim maliyet revizyon geçmişi (audit benzeri).
model ProductCostHistory {
  id                 Int      @id @default(autoincrement())
  productId          Int
  recordedAt         DateTime @default(now())
  purchaseUnitCost   Float
  productionUnitCost Float
  overheadUnitCost   Float
  totalUnitCost      Float
  reason             String // NEW_PURCHASE | PRODUCT_EXPENSE | GENERAL_EXPENSE | RECOMPUTE
  sourceEntity       String?
  sourceId           Int?
  notes              String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}
