# Backend environment — copy to .env and fill in.
PORT=4000

# SQLite path is resolved relative to the prisma/ schema dir, so "./dev.db"
# lives at backend/prisma/dev.db. Use a PostgreSQL URL in production.
DATABASE_URL="file:./dev.db"

# One-off Excel data migration source (npm run db:import).
EXCEL_SOURCE_PATH="../Kadim Naturel dosyasının kopyası.xlsx"

# Auth secret — REQUIRED (min 16 chars). In production the server refuses to
# start without it; generate a strong random value.
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional: lock CORS to the frontend origin in production.
# FRONTEND_ORIGIN="https://erp.example.com"

# Optional seed-user overrides (npm run db:seed-users).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="strong-password"
